# Server
PORT=3000

# Storage — sqlite database file
SQLITE_FILE=database.sqlite

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Plunk Email Configuration
PLUNK_API_KEY=your_plunk_api_key_here
PLUNK_SENDER_EMAIL=noreply@yourdomain.com

# Telegram notifications (optional — signup notifications are skipped when unset)
TELEGRAM_BOT_TOKEN=123456789:your_bot_token_from_botfather
TELEGRAM_CHAT_IDS=1689240298

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# SSO Configuration
SSO_PASSWORD=your_default_sso_password_here

# API-key encryption secret (AES-256-GCM, exactly 32 bytes)
MERCHANT_API_KEY_ENCRYPTION_SECRET=your_32_byte_encryption_secret_here!!

# Backend base URL (used to build gateway callback URLs)
BACKEND_BASE_URL=http://localhost:3000

# Frontend origin (redirect target for gate / google callback handoffs)
FRONTEND_URL=http://localhost:5000

# Payment gateways
PAYSTACK_SECRET_KEY=your_paystack_secret_key
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key
KORAPAY_SECRET_KEY=your_korapay_secret_key
MONIFY_API_KEY=your_monnify_api_key
MONIFY_SECRET_KEY=your_monnify_secret_key
SEERBIT_PUBLIC_KEY=your_seerbit_public_key
SEERBIT_SECRET_KEY=your_seerbit_secret_key

# Cloudflare R2 (object storage)
R2_BUCKET_NAME=your_r2_bucket_name
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com