{
  "name": "once-pay-be",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^4.19.2",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.31.0",
    "node-cron": "^4.6.0",
    "sequelize": "^6.37.3",
    "socket.io": "^4.8.4",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.7",
    "@types/node-cron": "^3.0.11",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5"
  },
  "moduleNameMapper": {
    "@modules/(.*)$": "<rootDir>/src/modules/$1",
    "@db/(.*)$": "<rootDir>/src/db/$1",
    "@utils/(.*)$": "<rootDir>/src/utils/$1",
    "@envs/(.*)$": "<rootDir>/src/envs/$1",
    "@decorators/(.*)$": "<rootDir>/src/decorators/$1",
    "@validators/(.*)$": "<rootDir>/src/validators/$1"
  }
}
